       sblock->s_feature_incompat &= ~flag;
       mapped_sblock->s_feature_incompat &= ~flag;
     }
+  pthread_spin_unlock (&global_lock);
 
   err = store_read (store, SBLOCK_OFFS >> store->log2_block_size,
