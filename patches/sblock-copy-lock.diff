@@ -194,8 +194,16 @@
 diskfs_set_hypermetadata (int wait, int clean)
 {
   error_t err = 0;
+  int dirty;
   diskfs_transaction_t *txn = diskfs_journal_start_transaction ();
 
+  /* SBLOCK and sblock_dirty change under global_lock: the allocators
