--- a/libdiskfs/node-cache.c
+++ b/libdiskfs/node-cache.c
@@ -105,6 +105,21 @@
   return diskfs_cached_lookup_context (inum, npp, NULL);
 }
 
+/* Release NP, a locked node that is not in the cache and was not read
+   (or whose read failed).  Its contents are not the inode's, so make
+   sure dropping it does not write them, or take it for a node without
+   links and delete the inode.  */
+static void
+forget_unread_node (struct node *np)
+{
+  np->dn_stat.st_nlink = 1;
+  np->allocsize = 0;
+  np->dn_set_ctime = 0;
+  np->dn_set_atime = 0;
+  np->dn_set_mtime = 0;
+  diskfs_nput (np);
+}
+
 /* Fetch inode INUM, set *NPP to the node structure;
    gain one user reference and lock the node.  */
 error_t
@@ -114,6 +129,7 @@
   error_t err;
   struct node *np, *tmp;
   hurd_ihash_locp_t slot;
+  struct references result;
 
   pthread_rwlock_rdlock (&nodecache_lock);
   np = hurd_ihash_locp_find (&nodecache, (hurd_ihash_key_t) &inum, &slot);
@@ -134,10 +150,13 @@
 			      &slot);
   if (tmp)
     {
-      /* We lost a race.  */
-      diskfs_nput (np);
+      /* We lost a race.  Take the winner, and let go of our node, which
+	 was never read, once nodecache_lock is released.  */
+      refcounts_ref (&tmp->refcounts, &result);
+      pthread_rwlock_unlock (&nodecache_lock);
+      forget_unread_node (np);
       np = tmp;
-      goto gotit;
+      goto referenced;
     }
 
   err = hurd_ihash_locp_add (&nodecache, slot,
@@ -156,13 +175,7 @@
     unlink_list_node (np);
     pthread_rwlock_unlock (&nodecache_lock);
 
-    /* Don't delete from disk. */
-    np->dn_stat.st_nlink = 1;
-    np->allocsize = 0;
-    np->dn_set_ctime = 0;
-    np->dn_set_atime = 0;
-    np->dn_set_mtime = 0;
-    diskfs_nput (np);
+    forget_unread_node (np);
     *npp = NULL;
 
     return err;
@@ -174,9 +187,18 @@
     }
 
  gotit:
-  diskfs_nref (np);
+  /* The reference is taken under nodecache_lock, so that
+     diskfs_try_dropping_softrefs sees it and keeps NP.  NP is locked
+     only once nodecache_lock is released: a thread dropping NP's last
+     hard reference holds NP's lock while it waits for nodecache_lock
+     (diskfs_nput, _diskfs_lastref).  So diskfs_nref, which locks NP for
+     the first hard reference, is not used here.  */
+  refcounts_ref (&np->refcounts, &result);
   pthread_rwlock_unlock (&nodecache_lock);
+ referenced:
   pthread_mutex_lock (&np->lock);
+  if (result.hard == 1)
+    diskfs_new_hardrefs (np);
   *npp = np;
   return 0;
 }
